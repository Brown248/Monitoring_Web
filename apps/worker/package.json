{
  "name": "@app/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/index.ts",
    "build": "esbuild src/index.ts src/cli/migrate.ts src/cli/create-user.ts src/cli/export-sites.ts src/cli/import-sites.ts --bundle --platform=node --target=node24 --format=cjs --sourcemap --external:pg-native --external:playwright-core --external:argon2 --outdir=dist --entry-names=[name] --out-extension:.js=.cjs",
    "start": "node --enable-source-maps dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file=../../.env --import tsx src/cli/migrate.ts",
    "user:create": "node --env-file=../../.env --import tsx src/cli/create-user.ts",
    "sites:export": "node --env-file=../../.env --import tsx src/cli/export-sites.ts",
    "sites:import": "node --env-file=../../.env --import tsx src/cli/import-sites.ts"
  },
  "dependencies": {
    "@app/core": "workspace:*",
    "@app/db": "workspace:*",
    "argon2": "0.45.1",
    "nodemailer": "10.1.7",
    "playwright-core": "1.64.1",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "smtp-server": "3.20.2",
    "typescript": "6.0.3"
  }
}
