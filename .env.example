# ค่าที่ไม่ใช่ความลับ (SMTP host, AI provider/model, Spreadsheet ID, ค่าเริ่มต้นการตรวจ, retention)
# ตั้งจากหน้า "ตั้งค่า" บนเว็บ และเก็บใน PostgreSQL — ไฟล์นี้เก็บเฉพาะ secret และค่าระดับระบบ
# ใส่ค่าตรง ๆ ไม่ต้องมีเครื่องหมายคำพูด (Docker อ่านไฟล์นี้แบบตรงตัว) · chmod 600 .env

# ===== PostgreSQL =====
POSTGRES_USER=monitor
# สร้างด้วย: openssl rand -hex 24  (ใช้ตัวอักษร/ตัวเลขเท่านั้น จะได้ไม่ต้อง URL-encode)
POSTGRES_PASSWORD=
POSTGRES_DB=monitor
# ใช้บนเครื่อง dev (pnpm dev:*, user:create) — ใน Docker ไม่ใช้ค่านี้ (compose สร้าง URL ชี้ container "postgres" เอง)
DATABASE_URL=postgres://monitor:CHANGE_ME@127.0.0.1:5432/monitor

# ===== App =====
# URL ที่ผู้ใช้เปิดเว็บ — ใช้ในลิงก์อีเมล
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Bangkok
WEB_PORT=3000
# เปิดพอร์ตเว็บที่ address ไหน — มี reverse proxy อยู่หน้าเว็บ ให้ตั้ง 127.0.0.1 (เข้าได้ทาง proxy เท่านั้น)
WEB_BIND=0.0.0.0
# debug | info | warn | error
LOG_LEVEL=info

# ===== Auth =====
# true เมื่อเปิดผ่าน HTTPS (reverse proxy)
COOKIE_SECURE=false
# จำนวน reverse proxy (nginx/Caddy/Cloudflare Tunnel) ที่อยู่หน้าเว็บ — 0 = ผู้ใช้เข้าพอร์ตเว็บตรง
# ใช้หา IP จริงของผู้ใช้สำหรับจำกัดการเดารหัสผ่าน (ตั้งผิด = ผู้ใช้ทุกคนดูเหมือนมาจาก IP เดียวกัน)
TRUST_PROXY_HOPS=0
# อายุ session เมื่อไม่ติ๊ก "จดจำ 7 วัน"
SESSION_TTL_HOURS=12

# ===== Worker =====
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=30000
# ปลายทาง canary คั่นด้วย comma — ใช้แยก "เน็ตของ Worker มีปัญหา" ออกจาก "เว็บล่มจริง" (เว้นว่าง = ปิด)
CANARY_URLS=https://www.google.com/generate_204,https://www.cloudflare.com/cdn-cgi/trace
# path ของ Chromium/Chrome/Edge สำหรับตรวจหน้าเว็บด้วยภาพ — เว้นว่าง = หาเองจากตำแหน่งมาตรฐาน (Docker ตั้งให้แล้ว)
CHROMIUM_PATH=

# ===== Secrets (ไม่แสดงและแก้จากหน้าเว็บ) =====
# รหัสผ่าน SMTP (host/port/username/ผู้ส่ง ตั้งในหน้าตั้งค่า)
SMTP_PASSWORD=
# (แนะนำ) server ที่อนุญาตให้ส่งรหัสผ่านไปได้ เช่น smtp-mail.outlook.com หรือ smtp.gmail.com
# ตั้งไว้แล้ว ถึงมีคนแก้ host ในหน้าตั้งค่า รหัสผ่านก็จะไม่ถูกส่งไป server อื่น
SMTP_ALLOWED_HOST=
# API key ของ AI provider ที่เลือกในหน้าตั้งค่า
AI_API_KEY=
# เฉพาะ OpenAI-compatible endpoint อื่น (เช่น Azure/Ollama) — เว้นว่าง = api.openai.com
AI_BASE_URL=
# JSON ของ Google service account (ทั้งก้อนในบรรทัดเดียว หรือ base64 ของไฟล์ JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ===== Backup (แสดงบนหน้าสถานะระบบ — เตือนถ้าไม่มี backup สำเร็จเกิน 36 ชม.) =====
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# คัดลอกไฟล์ backup ไปอีกที่ทุกครั้ง (แนะนำ — ดิสก์เสียจะได้ไม่เสียทั้งฐานข้อมูลและ backup)
#   โฟลเดอร์ที่ mount ไว้ เช่น /mnt/nas/monitor  หรือ  user@host:/path (scp ต้องตั้ง SSH key ไว้)
BACKUP_COPY_TO=
# ป้ายชื่อปลายทางที่แสดงบนหน้าเว็บ (เว้นว่าง = แสดง path จริง)
BACKUP_DESTINATION=

# ===== ทดสอบใช้งานจริง (Journey) — รหัสผ่านของบัญชีทดสอบ =====
# ในหน้าเว็บใส่ secret:CRM_USER / secret:CRM_PASS แล้วตั้งค่าจริงที่นี่ (เฉพาะ Worker อ่าน)
# ต้องผูกโดเมนด้วย — secret ใช้ได้เฉพาะบนเว็บโดเมนนี้ (กันตั้ง journey บนเว็บอื่นเพื่อดึงรหัส)
# JOURNEY_CRM_USER=
# JOURNEY_CRM_PASS=
# JOURNEY_CRM_DOMAIN=crm.syntechnology.com
